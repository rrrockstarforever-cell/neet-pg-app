# Copy to .env (or export these in your shell). Keys set here are used when the browser sends none.
PORT=3000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# For "Custom OpenAI-compatible" in Settings (set the base URL there too)
CUSTOM_API_KEY=

# Market data (Markets tab). Free key at alphavantage.co. Optional with Yahoo.
ALPHAVANTAGE_API_KEY=
# Brave Search key for web search in chat
BRAVE_API_KEY=
